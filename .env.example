# Copy this file to ".env" and fill in your own Twilio values (Twilio Console > Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Use ONE of the two below:
TWILIO_FROM=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only these numbers can receive SMS (comma separated, E.164). Strongly recommended.
ALLOWED_TO=+919876543210

# sms | flow | both
SEND_MODE=sms
TWILIO_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
# Minimum seconds between two SMS, so a bug cannot spam or burn your credit
MIN_GAP_SECONDS=15
